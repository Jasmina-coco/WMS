# Nusxa oling: cp .env.example .env  va qiymatlarni o'zingizniki bilan almashtiring.
# Bu faylda haqiqiy parol yoki kalit bo'lmasligi kerak.

DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

DB_NAME=wms
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
# RDS uchun "require" qo'ying
DB_SSLMODE=prefer

SITE_NAME=OmborHub
CONTACT_PHONE=+998 88 803 30 24
CONTACT_EMAIL=jasminaismoilova279@gmail.com

# S3: lokalda False, serverda True. Kalitlar kerak emas — EC2 IAM role orqali kiradi.
USE_S3=False
AWS_S3_BUCKET=
AWS_REGION=eu-central-1

# Serverda HTTPS yoqilgandan keyin True
SECURE_COOKIES=False
