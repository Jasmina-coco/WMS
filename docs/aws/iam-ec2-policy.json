{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WmsBucketObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::wms-vangogh-files-132074799573/*"
    },
    {
      "Sid": "WmsBucketList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::wms-vangogh-files-132074799573"
    },
    {
      "Sid": "ReadRdsMasterSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:ap-southeast-2:132074799573:secret:rds!db-b0d819fc-3142-47ae-a867-097da70ee258-*"
    }
  ]
}
